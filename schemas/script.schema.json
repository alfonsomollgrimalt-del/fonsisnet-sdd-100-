{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fonsisnet.local/schemas/script.schema.json",
  "title": "FONSISNET Timed Script",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "duration_seconds", "scenes", "human_review"],
  "properties": {
    "project":{"type":"string","minLength":1},
    "duration_seconds":{"type":"integer","minimum":5,"maximum":60},
    "human_review":{"type":"boolean","const":true},
    "scenes":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","start","end","visual","voiceover","on_screen_text","claims"],"properties":{"id":{"type":"string"},"start":{"type":"number","minimum":0},"end":{"type":"number","exclusiveMinimum":0},"visual":{"type":"string"},"voiceover":{"type":"string"},"on_screen_text":{"type":"string"},"claims":{"type":"array","items":{"type":"string"}},"assets":{"type":"array","items":{"type":"string"}}}}}
  }
}
